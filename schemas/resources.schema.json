{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pirate-idle.local/schemas/resources.schema.json",
  "title": "Resource definitions",
  "description": "Every resource the game can store, gather or trade.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "icon"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Stable identifier used by the core and the data files."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Player-facing name."
      },
      "icon": {
        "type": "string",
        "minLength": 1,
        "description": "Emoji or short glyph shown in the UI."
      }
    }
  }
}
