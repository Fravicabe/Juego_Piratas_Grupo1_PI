{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pirate-idle.local/schemas/skills.schema.json",
  "title": "Skill definitions",
  "description": "Skill identity and Progress Knight XP curve parameters.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description",
      "baseXp",
      "xpPerSecond",
      "effectPerLevel",
      "effectLabel"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "baseXp": {
        "type": "number",
        "minimum": 1,
        "description": "Base of the XP curve: baseXp * level * 1.01^(level - 1)."
      },
      "xpPerSecond": {
        "type": "number",
        "minimum": 0,
        "description": "XP per second while the skill is trained by an action."
      },
      "effectPerLevel": {
        "type": "number",
        "minimum": 0,
        "description": "Fractional bonus per level: 0.05 means +5%."
      },
      "effectLabel": {
        "type": "string",
        "minLength": 1,
        "description": "What the effect improves, for the UI."
      }
    }
  }
}
